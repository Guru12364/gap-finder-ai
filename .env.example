# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq API (LLM for quiz generation, evaluation, explanations)
GROQ_API_KEY=your_groq_api_key

# Embedding Provider: 'huggingface' (free default) or 'openai'
EMBEDDING_PROVIDER=huggingface

# Hugging Face Inference API (free tier available)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# OpenAI (optional, for embeddings if preferred)
OPENAI_API_KEY=your_openai_api_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gap Detection Thresholds (optional, defaults shown)
GAP_WEAK_THRESHOLD=50
GAP_STRONG_THRESHOLD=80
